{
  "headers": [
    {
      "source": "/pdf/:token/file",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/contracts/:path*",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://back01-production-3338.up.railway.app/api/:path*"
    },
    {
      "source": "/pdf/:path*",
      "destination": "https://back01-production-3338.up.railway.app/pdf/:path*"
    },
    {
      "source": "/((?!api|pdf).*|[^.]+)",
      "destination": "/index.html"
    }
  ]
}
